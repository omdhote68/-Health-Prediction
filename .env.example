# Copy this file to ".env" and put your real key there. Never commit ".env".
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: override the Gemini model (default: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Optional: override where the SQLite file is stored (default: data/patients.db)
# HEALTH_DB_PATH=data/patients.db
